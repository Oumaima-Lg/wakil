# Copier ce fichier en .env et remplacer les valeurs. Le fichier .env n'est jamais commité.
POSTGRES_USER=wakil
POSTGRES_PASSWORD=a-remplacer
POSTGRES_DB=banque_atlas_demo

# Base séparée de l'agent (ses conversations) : son propre utilisateur, sans aucun droit sur la base de la banque.
AGENT_POSTGRES_USER=wakil_agent
AGENT_POSTGRES_PASSWORD=a-remplacer
AGENT_POSTGRES_DB=wakil_agent

# Base de la FAQ (service rag-faq) : son propre utilisateur, sans aucun droit sur les autres bases.
FAQ_POSTGRES_USER=wakil_faq
FAQ_POSTGRES_PASSWORD=a-remplacer
FAQ_POSTGRES_DB=wakil_faq

# Clés des jetons de session (RS256), une ligne chacune. Ne pas les écrire à la main : les ajouter à .env avec
#   cd apps/portail-api && uv run python -m app.cles >> ../../.env
# WAKIL_JWT_CLE_PRIVEE : pour portail-api seulement (il signe les jetons).
# WAKIL_JWT_CLE_PUBLIQUE : pour agent-api (il vérifie les jetons, sans pouvoir en créer).
