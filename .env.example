# Copier ce fichier en .env et remplacer les valeurs. Le fichier .env n'est jamais commité.
POSTGRES_USER=wakil
POSTGRES_PASSWORD=a-remplacer
POSTGRES_DB=banque_atlas_demo

# Base séparée de l'agent (ses conversations) : son propre utilisateur, sans aucun droit sur la base de la banque.
AGENT_POSTGRES_USER=wakil_agent
AGENT_POSTGRES_PASSWORD=a-remplacer
AGENT_POSTGRES_DB=wakil_agent

# Clé qui signe les jetons de session d'agent-api (au moins 32 caractères, tirée au hasard).
WAKIL_JWT_SECRET=a-remplacer
